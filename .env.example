# Supabase project (Settings → API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy anon key

# Optional: invitation-only sign-up. Comma-separated emails allowed to create an account through the app.
# Leave unset for open sign-up. Users added in the Supabase dashboard are unaffected.
SIGNUP_ALLOWED_EMAILS=

# Optional: full-case model analysis (Phase 3). Server-side only. Leave unset to run rules-only.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
STRATEGY_MODEL=
